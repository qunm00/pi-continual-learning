{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESnext",
		"moduleResolution": "bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"outDir": "dist",
		"declaration": false,
		"allowImportingTsExtensions": true,
		"noEmit": true
	},
	"include": [
		"extensions/**/*.ts"
	]
}
